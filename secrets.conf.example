# TagoIO credentials for the TIP payload (%i device token, %h hash).
#
# Copy this file to secrets.conf and fill in your values. secrets.conf is
# ignored by git and merged into the build automatically by CMakeLists.txt,
# so the real values never land in the repository.
CONFIG_TAGO_DEVICE_TOKEN="your-device-token"
CONFIG_TAGO_HASH="your-device-hash"
