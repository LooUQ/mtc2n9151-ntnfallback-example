menu "UDP Sample Settings"

config UDP_APN
	string "APN used for the IP connection"
	default "nbiot"

config UDP_ALLOC_NEW_CID
	bool "Allocate a new (dedicated) context identifier for the connection"

config UDP_SERVER_ADDRESS
	string "UDP server hostname or IP address"
	default "192.0.2.1"

config UDP_SERVER_PORT
	int "UDP server port"
	default 4242

config UDP_RECV_DELAY_MS
	int "Delay between UDP send and receive (ms)"
	default 0
	help
	  Wait this many milliseconds after sending before attempting to receive
	  the reply. Useful on high-latency NTN links where the response is not
	  available immediately. 0 disables the delay (receive right after send).

config UDP_RECV_TIMEOUT_S
	int "UDP receive timeout (s)"
	default 5
	help
	  How long recv() waits for a reply before giving up (SO_RCVTIMEO). On a
	  timeout recv() returns -1 with errno EAGAIN, logged as "No reply".

config UDP_PAYLOAD
	string "Payload for UDP transmission"
	default "Hello, World!"

config NTN_LOCATION
	string "Location information for NTN (lat,lon,alt)"
	default "44.698883,-85.600258,153.025009"

config NTN_BAND_LIST
	string "NTN band list for AT%XBANDLOCK (comma-separated)"
	default "23,255,256"

config TEST_NAME
    string "Test name to use in the payload"
    default "UDP Sample Test"

config TEST_INTERVAL
    int "Interval between UDP transmissions (s)"
    default 10

config TAGO_DEVICE_TOKEN
    string "Device identifier token for payloads"
    default "REDACTED-TAGO-TOKEN"

config TAGO_HASH
    string "Device hash token for payloads"
    default "REDACTED-TAGO-HASH"

config TEST_PAYLOADTEMPLATE
    string "Payload template sent every TEST_INTERVAL seconds"
    default "[tid=%n;seq:=%c;rsrp:=%r;rsrq:=%q]"
    help
      Sent verbatim except for these tokens, expanded at send time:
        %n  test name (CONFIG_TEST_NAME)
        %i  device token (CONFIG_TAGO_DEVICE_TOKEN)
        %h  device hash (CONFIG_TAGO_HASH)
        %c  send counter (increments each interval)
        %r  RSRP in dBm (0 if not detectable)
        %q  RSRQ in dB  (0 if not detectable)
        %s  SNR in dB from %XMONITOR (0 if not available)
        %t  Unix epoch seconds from modem time (0 if network time unset)
        %%  a literal '%'

endmenu

module = UDP
module-str = UDP sample

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
