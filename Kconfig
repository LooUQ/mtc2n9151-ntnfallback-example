menu "UDP Sample Settings"

config UDP_APN
	string "APN used for the IP connection"
	default "nbiot"

config UDP_ALLOC_NEW_CID
	bool "Allocate a new (dedicated) context identifier for the connection"

config UDP_SERVER_ADDRESS
	string "UDP server hostname or IP address"
	default "192.0.2.1"

config UDP_SERVER_PORT
	int "UDP server port"
	default 4242

config UDP_RECV_DELAY_MS
	int "Delay between UDP send and receive (ms)"
	default 0
	help
	  Wait this many milliseconds after sending before attempting to receive
	  the reply. Useful on high-latency NTN links where the response is not
	  available immediately. 0 disables the delay (receive right after send).

config UDP_RECV_TIMEOUT_S
	int "UDP receive timeout (s)"
	default 5
	help
	  How long recv() waits for a reply before giving up (SO_RCVTIMEO). On a
	  timeout recv() returns -1 with errno EAGAIN, logged as "No reply".

config UDP_PAYLOAD
	string "Payload for UDP transmission"
	default "Hello, World!"

config NTN_LOCATION
	string "Fixed NTN location (lat,lon,alt); empty = acquire from internal GNSS"
	default ""
	help
	  If set to a valid "lat,lon,alt" string, this fixed position is supplied to
	  the modem for NTN Doppler/timing pre-compensation (bench testing or sites
	  with poor sky view). If left empty, the position is acquired dynamically
	  from the nRF9151 internal GNSS receiver instead.

config GNSS_FIX_RETRY_S
	int "GNSS fix retry timeout (s), 0 = run until a valid fix"
	default 0
	help
	  Maximum time the GNSS receiver runs while trying to produce a valid fix
	  before giving up and restarting the attempt. 0 lets GNSS run indefinitely
	  until it produces a valid fix (block until fix). Feeds
	  nrf_modem_gnss_fix_retry_set().

config NTN_LOCATION_VALIDITY_S
	int "Validity (s) reported with the NTN location, 0 = infinite"
	default 3600
	help
	  Validity time reported to the modem with each location update. A finite
	  value makes the modem periodically request a fresh location; 0 means the
	  location never expires (appropriate for a permanently stationary device).

config NTN_REFIX_MIN_INTERVAL_S
	int "Minimum interval (s) between full GNSS re-acquisitions"
	default 600
	help
	  When the modem requests a fresh location (dynamic/GNSS mode), re-send the
	  cached fix if it is newer than this, instead of dropping the NTN link to
	  run a full GNSS re-acquisition. Bounds link interruptions on a stationary
	  or slow-moving device.

config GNSS_COEX0_CMD
	string "COEX0 configuration command for the GNSS LNA path (empty = skip)"
	default "AT%XCOEX0=1,1,1570,1580"
	help
	  AT command issued once at boot (while the modem is idle) to configure the
	  COEX0 pin that gates the external GNSS LNA/RF switch. The board-specific
	  value must match the MTC2-N9151 hardware. Empty string skips it (e.g. when
	  the Modem antenna library handles COEX0 instead).

config NTN_BAND_LIST
	string "NTN band list for AT%XBANDLOCK (comma-separated)"
	default "23,255,256"

config TEST_NAME
    string "Test name to use in the payload"
    default "UDP Sample Test"

config TEST_INTERVAL
    int "Interval between UDP transmissions (s)"
    default 10

config TAGO_DEVICE_TOKEN
    string "Device identifier token for payloads"
    default "REDACTED-TAGO-TOKEN"

config TAGO_HASH
    string "Device hash token for payloads"
    default "REDACTED-TAGO-HASH"

config TEST_PAYLOADTEMPLATE
    string "Payload template sent every TEST_INTERVAL seconds"
    default "[tid=%n;seq:=%c;rsrp:=%r;rsrq:=%q]"
    help
      Sent verbatim except for these tokens, expanded at send time:
        %n  test name (CONFIG_TEST_NAME)
        %i  device token (CONFIG_TAGO_DEVICE_TOKEN)
        %h  device hash (CONFIG_TAGO_HASH)
        %c  send counter (increments each interval)
        %r  RSRP in dBm (0 if not detectable)
        %q  RSRQ in dB  (0 if not detectable)
        %s  SNR in dB from %XMONITOR (0 if not available)
        %t  Unix epoch seconds from modem time (0 if network time unset)
        %%  a literal '%'

endmenu

module = UDP
module-str = UDP sample

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
